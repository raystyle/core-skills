#!/bin/sh
# generated by `project hooks install`
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1
if command -v project >/dev/null 2>&1; then
  exec project hooks run pre-push
fi
if command -v uv >/dev/null 2>&1; then
  exec uv run project hooks run pre-push
fi
echo "project: CLI not found, skip push doc sync" >&2
exit 0
